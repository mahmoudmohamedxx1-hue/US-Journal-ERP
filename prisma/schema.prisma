// Prisma schema for US Journal ERP — production-ready accounting system
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================
// Multi-tenant core
// ============================

model Organization {
  id          String   @id @default(cuid())
  name        String
  legalName   String?
  taxId       String?
  currency    String   @default("USD")
  baseCurrency String  @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  memberships  Membership[]
  accounts     Account[]
  fiscalYears  FiscalYear[]
  journals     Journal[]
  vendors      Vendor[]
  customers    Customer[]
  bankAccounts BankAccount[]
  taxCodes     TaxCode[]
  departments  Department[]
  locations    Location[]
  projects     Project[]
  auditLogs    AuditLog[]
  products       Product[]
  warehouses     Warehouse[]
  inventoryMoves InventoryMove[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  reconciliations Reconciliation[]
  recurringJournals RecurringJournal[]
  budgets        Budget[]
  exchangeRates ExchangeRate[]
  documents      Document[]
  customFields   CustomField[]
  payments      Payment[]
  fixedAssets   FixedAsset[]
  timesheets    Timesheet[]
  approvalSteps ApprovalStep[]
  notifications Notification[]
}

model User {
  id            String   @id @default(cuid())
  organizationId String
  email         String   @unique
  name          String
  passwordHash  String   // bcrypt-hashed — never store plaintext
  role          String   @default("Viewer") // Viewer, Accountant, Approver, Controller, Administrator, Auditor
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  memberships  Membership[]
  sessions     Session[]
  journalsCreated   Journal[]      @relation("JournalCreatedBy")
  journalsSubmitted Journal[]      @relation("JournalSubmittedBy")
  journalsApproved Journal[]      @relation("JournalApprovedBy")
  journalsPosted    Journal[]      @relation("JournalPostedBy")
  approvals         JournalApproval[] @relation("JournalApprovals")
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("Viewer")
  createdAt      DateTime @default(now())

  user          User         @relation(fields: [userId], references: [id])
  organization  Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

// ============================
// Chart of Accounts
// ============================

model Account {
  id              String   @id @default(cuid())
  organizationId  String
  code            String
  name            String
  accountType     String   // Asset, Liability, Equity, Revenue, Expense
  subType         String?  // e.g. "Current Asset", "Long-term Liability"
  parentId        String?
  normalBalance   String   @default("Debit") // Debit or Credit
  taxBehavior     String?  // Taxable, Non-taxable, etc.
  active          Boolean  @default(true)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  parent       Account?        @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]       @relation("AccountHierarchy")
  journalLines JournalLine[]
  budgets      Budget[]
  fixedAssets  FixedAsset[]

  @@unique([organizationId, code])
}

// ============================
// Fiscal Calendar
// ============================

model FiscalYear {
  id             String   @id @default(cuid())
  organizationId String
  name           String   // e.g. "FY 2026"
  startDate      DateTime
  endDate        DateTime
  status         String   @default("Open") // Open, Closed
  createdAt      DateTime @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id])
  periods       FiscalPeriod[]
  budgets       Budget[]
}

model FiscalPeriod {
  id           String   @id @default(cuid())
  fiscalYearId String
  name         String   // e.g. "January 2026"
  periodNumber Int
  startDate    DateTime
  endDate      DateTime
  status       String   @default("Open") // Open, Closed, Locked
  closedAt     DateTime?
  closedById   String?

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id])
  journals  Journal[]
}

// ============================
// Journal Entries (the heart of the GL)
// ============================

model Journal {
  id              String   @id @default(cuid())
  organizationId  String
  journalNumber   String   @unique
  journalDate     DateTime
  postingDate     DateTime?
  fiscalPeriodId  String?
  source          String?  // Manual, AP, AR, Payroll, etc.
  reference       String?
  description     String?
  currency        String   @default("USD")
  exchangeRate    Int    @default(100) // stored in basis points (100 = 1.0x)
  status          String   @default("Draft") // Draft, Submitted, Under Review, Approved, Rejected, Posted, Reversed
  reversalOfId    String?
  totalDebit      Int    @default(0)
  totalCredit     Int    @default(0)
  createdById     String
  submittedById   String?
  approvedById    String?
  postedById      String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  postedAt        DateTime?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  fiscalPeriod FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id])
  lines        JournalLine[]
  approvals    JournalApproval[]
  attachments  JournalAttachment[]
  reversalOf   Journal?       @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy   Journal[]      @relation("JournalReversal")
  createdBy    User            @relation("JournalCreatedBy", fields: [createdById], references: [id])
  submittedBy  User?           @relation("JournalSubmittedBy", fields: [submittedById], references: [id])
  approvedBy   User?           @relation("JournalApprovedBy", fields: [approvedById], references: [id])
  postedBy     User?           @relation("JournalPostedBy", fields: [postedById], references: [id])
}

model JournalLine {
  id            String   @id @default(cuid())
  journalId     String
  lineNumber    Int
  accountId     String
  description   String?
  debit         Int    @default(0)
  credit        Int    @default(0)
  taxCodeId     String?
  departmentId  String?
  locationId    String?
  projectId     String?
  customerId    String?
  vendorId      String?
  dueDate       DateTime?

  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id])
  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
}

model JournalApproval {
  id         String   @id @default(cuid())
  journalId  String
  action     String   // Submitted, Approved, Rejected, Posted, Reversed
  byUserId   String
  comment    String?
  at         DateTime @default(now())

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  byUser  User    @relation("JournalApprovals", fields: [byUserId], references: [id])
}

model JournalAttachment {
  id         String   @id @default(cuid())
  journalId  String
  fileName   String
  fileSize   Int
  mimeType   String
  url        String
  uploadedAt DateTime @default(now())

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
}

// ============================
// Vendors / Customers (AP / AR)
// ============================

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  vendorNumber   String
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  taxId          String?
  paymentTerms   String?  // e.g. "Net 30"
  currency       String   @default("USD")
  active         Boolean  @default(true)
  balance        Int    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  bills        Bill[]
  journalLines JournalLine[]
  purchaseOrders PurchaseOrder[]
}

model Bill {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String
  billNumber     String
  billDate       DateTime
  dueDate        DateTime
  amount         Int
  amountPaid     Int    @default(0)
  currency       String   @default("EGP")
  status         String   @default("Open") // Open, Partially Paid, Paid, Overdue
  description    String?
  createdAt      DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id])
  lines  BillLine[]
  allocations Allocation[]
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  customerNumber String
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  taxId          String?
  paymentTerms   String?
  currency       String   @default("USD")
  active         Boolean  @default(true)
  balance        Int    @default(0)
  creditLimit    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  invoices     Invoice[]
  journalLines JournalLine[]
  salesOrders  SalesOrder[]
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  invoiceNumber  String
  invoiceDate    DateTime
  dueDate        DateTime
  amount         Int
  amountPaid     Int    @default(0)
  currency       String   @default("EGP")
  status         String   @default("Open") // Open, Partially Paid, Paid, Overdue
  description    String?
  createdAt      DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  lines    InvoiceLine[]
  allocations Allocation[]
}

// ============================
// Banking
// ============================

model BankAccount {
  id             String   @id @default(cuid())
  organizationId String
  accountName    String
  bankName       String?
  accountNumber  String
  accountType    String   @default("Checking") // Checking, Savings, Cash
  currency       String   @default("USD")
  balance        Int    @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  transactions BankTransaction[]
  reconciliations Reconciliation[]
  payments      Payment[]
}

model BankTransaction {
  id             String   @id @default(cuid())
  bankAccountId  String
  date           DateTime
  amount         Int
  type           String   // Credit (in), Debit (out)
  description    String?
  reference      String?
  reconciled     Boolean  @default(false)
  reconciledAt   DateTime?
  journalId      String?
  createdAt      DateTime @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
}

// ============================
// Tax
// ============================

model TaxCode {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  rate           Int    // e.g. 1400 for 14% (basis points × 100)
  jurisdiction   String?
  taxType        String   @default("VAT") // VAT, Sales Tax, GST
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  invoiceLines InvoiceLine[]
  billLines    BillLine[]
}

// ============================
// Dimensions
// ============================

model Department {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Location {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  active         Boolean  @default(true)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  timesheets   Timesheet[]
}

// ============================
// Audit Log
// ============================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  action         String   // CREATE_JOURNAL, SUBMIT, APPROVE, POST, REVERSE, etc.
  entityType     String   // Journal, Account, User, etc.
  entityId       String?
  description    String
  metadata       String?  // JSON
  prevHash       String?  // hash-chain: SHA256 of previous audit log entry
  hash           String?  // SHA256 of this entry's content (id+action+entityType+description+prevHash)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
}

// ============================
// Inventory Management (P4.1)
// ============================

model Product {
  id             String   @id @default(cuid())
  organizationId String
  sku            String
  name           String
  description    String?
  category       String?
  unit           String   @default("each") // each, kg, liter, hour, etc.
  costPrice      Int      @default(0) // in cents
  salePrice      Int      @default(0) // in cents
  stockQuantity  Int      @default(0)
  reorderPoint   Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  inventoryMoves InventoryMove[]
  poLines        PurchaseOrderLine[]
  soLines        SalesOrderLine[]
  invoiceLines  InvoiceLine[]
  billLines     BillLine[]

  @@unique([organizationId, sku])
}

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  location       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id])
  inventoryMoves InventoryMove[]

  @@unique([organizationId, code])
}

model InventoryMove {
  id           String   @id @default(cuid())
  organizationId String
  productId    String
  warehouseId  String?
  quantity     Int // positive = in, negative = out
  moveType     String // PURCHASE, SALE, ADJUSTMENT, TRANSFER, RETURN
  reference     String? // PO number, SO number, etc.
  notes         String?
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id])
}

// ============================
// Purchase Orders (P4.2)
// ============================

model PurchaseOrder {
  id             String   @id @default(cuid())
  organizationId String
  poNumber       String   @unique
  orderDate      DateTime
  expectedDate   DateTime?
  vendorId       String
  status         String   @default("Draft") // Draft, Submitted, Received, Cancelled
  totalAmount    Int      @default(0) // in cents
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  vendor       Vendor           @relation(fields: [vendorId], references: [id])
  lines        PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String?
  description     String
  quantity        Int
  unitPrice       Int // in cents
  totalPrice      Int // in cents
  receivedQty     Int @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id])
}

// ============================
// Sales Orders (P4.3)
// ============================

model SalesOrder {
  id             String   @id @default(cuid())
  organizationId String
  soNumber       String   @unique
  orderDate      DateTime
  expectedDate   DateTime?
  customerId     String
  status         String   @default("Draft") // Draft, Confirmed, Shipped, Delivered, Cancelled
  totalAmount    Int      @default(0) // in cents
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     Customer        @relation(fields: [customerId], references: [id])
  lines        SalesOrderLine[]
}

model SalesOrderLine {
  id           String @id @default(cuid())
  salesOrderId String
  productId    String?
  description  String
  quantity     Int
  unitPrice    Int // in cents
  totalPrice   Int // in cents
  shippedQty   Int @default(0)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id])
}

// ============================
// Bank Reconciliation (P4.4)
// ============================

model Reconciliation {
  id             String   @id @default(cuid())
  organizationId String
  bankAccountId  String
  statementDate  DateTime
  startingBalance Int    // in cents
  endingBalance   Int    // in cents
  status          String @default("Open") // Open, Reconciled
  createdAt       DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  bankAccount  BankAccount    @relation(fields: [bankAccountId], references: [id])
}

// ============================
// Recurring Journals (P4.5)
// ============================

model RecurringJournal {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  frequency      String   // DAILY, WEEKLY, MONTHLY, QUARTERLY, YEARLY
  nextRunDate    DateTime
  lastRunDate    DateTime?
  template       String   // JSON: { lines: [{ accountId, debit, credit, description }] }
  status         String   @default("Active") // Active, Paused, Stopped
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ============================
// Budgets (P4.6)
// ============================

model Budget {
  id             String   @id @default(cuid())
  organizationId String
  fiscalYearId   String?
  accountId      String
  period         String   // e.g. "2026-01" for January 2026, "2026" for full year
  budgetAmount   Int      // in cents
  actualAmount   Int      @default(0) // in cents, updated from posted journals
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  fiscalYear    FiscalYear?  @relation(fields: [fiscalYearId], references: [id])
  account       Account      @relation(fields: [accountId], references: [id])

  @@unique([organizationId, accountId, period])
}

// ============================
// Exchange Rates (T1.1)
// ============================

model ExchangeRate {
  id             String   @id @default(cuid())
  organizationId String
  fromCurrency   String   // e.g. "USD"
  toCurrency     String   // e.g. "EGP"
  rate           Int      // stored as basis points (e.g. 4800 = 48.00 EGP per 1 USD)
  date           DateTime // effective date for this rate
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, fromCurrency, toCurrency, date])
}

// ============================
// Invoice/Bill Line Items (T1.2)
// ============================

model InvoiceLine {
  id           String   @id @default(cuid())
  invoiceId    String
  lineNumber   Int
  productId    String?
  description  String
  quantity     Int      // can be fractional (stored as basis points)
  unitPrice    Int      // in cents
  taxCodeId    String?
  taxAmount    Int      @default(0) // in cents
  totalPrice   Int      // in cents (quantity * unitPrice + taxAmount)
  createdAt    DateTime @default(now())

  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])
  taxCode   TaxCode?  @relation(fields: [taxCodeId], references: [id])
}

model BillLine {
  id           String   @id @default(cuid())
  billId       String
  lineNumber   Int
  productId    String?
  description  String
  quantity     Int
  unitPrice    Int      // in cents
  taxCodeId    String?
  taxAmount    Int      @default(0)
  totalPrice   Int
  createdAt    DateTime @default(now())

  bill      Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])
  taxCode   TaxCode?  @relation(fields: [taxCodeId], references: [id])
}

// ============================
// Payments + Allocations (T1.4)
// ============================

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  paymentNumber  String   @unique
  paymentDate    DateTime
  paymentType    String   // RECEIPT (from customer) or PAYMENT (to vendor)
  partyType      String   // CUSTOMER or VENDOR
  partyId        String   // customer.id or vendor.id
  bankAccountId  String
  amount         Int      // in cents
  currency       String   @default("EGP")
  exchangeRate   Int      @default(100) // basis points (100 = 1.0x)
  reference      String?  // check number, transfer ref
  notes          String?
  status         String   @default("Posted") // Draft, Posted, Reversed
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id])
  allocations  Allocation[]
}

model Allocation {
  id           String   @id @default(cuid())
  paymentId    String
  invoiceId    String?
  billId       String?
  amount       Int      // in cents allocated to this invoice/bill
  createdAt    DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  bill    Bill?    @relation(fields: [billId], references: [id])
}

// ============================
// Document Attachments (T2.12)
// ============================

model Document {
  id             String   @id @default(cuid())
  organizationId String
  fileName       String
  fileSize       Int
  mimeType       String
  fileData       String   // base64-encoded file content
  entityType     String   // Journal, Invoice, Bill, Vendor, Customer, etc.
  entityId       String?
  uploadedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ============================
// Custom Fields (T2.13)
// ============================

model CustomField {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String   // Account, Vendor, Customer, Product, etc.
  fieldName      String
  fieldType      String   @default("text") // text, number, date, select
  fieldOptions   String?  // JSON array for select type
  isRequired     Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  values        CustomFieldValue[]

  @@unique([organizationId, entityType, fieldName])
}

model CustomFieldValue {
  id             String   @id @default(cuid())
  customFieldId  String
  entityId       String
  value          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, entityId])
}

// ============================
// Fixed Assets + Depreciation (T3.22)
// ============================

model FixedAsset {
  id              String   @id @default(cuid())
  organizationId String
  assetNumber     String
  name            String
  description     String?
  accountId       String   // links to Fixed Asset account in chart
  purchaseDate    DateTime
  purchaseCost    Int      // in cents
  salvageValue    Int      @default(0) // in cents
  usefulLifeMonths Int     // e.g. 60 for 5 years
  depreciationMethod String @default("straight-line") // straight-line, declining-balance
  currentBookValue Int    // in cents, = purchaseCost - accumulatedDepreciation
  accumulatedDepreciation Int @default(0) // in cents
  status          String   @default("Active") // Active, Disposed, Fully Depreciated
  createdAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])
  depreciationRecords DepreciationRecord[]

  @@unique([organizationId, assetNumber])
}

model DepreciationRecord {
  id              String   @id @default(cuid())
  fixedAssetId    String
  period          String   // e.g. "2026-08"
  depreciationAmount Int   // in cents
  bookValueAfter  Int      // in cents
  journalId       String?  // links to posted journal if auto-created
  createdAt       DateTime @default(now())

  fixedAsset FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)
}

// ============================
// Timesheets (T3.24)
// ============================

model Timesheet {
  id              String   @id @default(cuid())
  organizationId String
  employeeName    String
  projectId       String?
  date            DateTime
  hours           Int      // stored as basis points (100 = 1 hour)
  description     String?
  billableRate    Int      @default(0) // in cents per hour
  status          String   @default("Draft") // Draft, Submitted, Approved, Billed
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
}

// ============================
// Multi-step Approval Workflow (T2.10)
// ============================

model ApprovalStep {
  id              String   @id @default(cuid())
  organizationId String
  entityType      String   // Journal, PurchaseOrder, SalesOrder, etc.
  stepNumber      Int
  approverRole    String   // Manager, Administrator, Controller
  description     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, entityType, stepNumber])
}

// ============================
// Notifications (T2.11)
// ============================

model Notification {
  id              String   @id @default(cuid())
  organizationId String
  userId          String?
  title           String
  message         String
  type            String   @default("info") // info, warning, success, error
  read            Boolean  @default(false)
  entityType      String?
  entityId        String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}
