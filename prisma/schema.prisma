// Prisma schema for US Journal ERP — production-ready accounting system
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================
// Multi-tenant core
// ============================

model Organization {
  id          String   @id @default(cuid())
  name        String
  legalName   String?
  taxId       String?
  currency    String   @default("USD")
  baseCurrency String  @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  memberships  Membership[]
  accounts     Account[]
  fiscalYears  FiscalYear[]
  journals     Journal[]
  vendors      Vendor[]
  customers    Customer[]
  bankAccounts BankAccount[]
  taxCodes     TaxCode[]
  departments  Department[]
  locations    Location[]
  projects     Project[]
  auditLogs    AuditLog[]
  products       Product[]
  warehouses     Warehouse[]
  inventoryMoves InventoryMove[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  reconciliations Reconciliation[]
  recurringJournals RecurringJournal[]
  budgets        Budget[]
}

model User {
  id            String   @id @default(cuid())
  organizationId String
  email         String   @unique
  name          String
  passwordHash  String   // bcrypt-hashed — never store plaintext
  role          String   @default("Viewer") // Viewer, Accountant, Approver, Controller, Administrator, Auditor
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  memberships  Membership[]
  sessions     Session[]
  journalsCreated   Journal[]      @relation("JournalCreatedBy")
  journalsSubmitted Journal[]      @relation("JournalSubmittedBy")
  journalsApproved Journal[]      @relation("JournalApprovedBy")
  journalsPosted    Journal[]      @relation("JournalPostedBy")
  approvals         JournalApproval[] @relation("JournalApprovals")
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("Viewer")
  createdAt      DateTime @default(now())

  user          User         @relation(fields: [userId], references: [id])
  organization  Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

// ============================
// Chart of Accounts
// ============================

model Account {
  id              String   @id @default(cuid())
  organizationId  String
  code            String
  name            String
  accountType     String   // Asset, Liability, Equity, Revenue, Expense
  subType         String?  // e.g. "Current Asset", "Long-term Liability"
  parentId        String?
  normalBalance   String   @default("Debit") // Debit or Credit
  taxBehavior     String?  // Taxable, Non-taxable, etc.
  active          Boolean  @default(true)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  parent       Account?        @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]       @relation("AccountHierarchy")
  journalLines JournalLine[]
  budgets      Budget[]

  @@unique([organizationId, code])
}

// ============================
// Fiscal Calendar
// ============================

model FiscalYear {
  id             String   @id @default(cuid())
  organizationId String
  name           String   // e.g. "FY 2026"
  startDate      DateTime
  endDate        DateTime
  status         String   @default("Open") // Open, Closed
  createdAt      DateTime @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id])
  periods       FiscalPeriod[]
  budgets       Budget[]
}

model FiscalPeriod {
  id           String   @id @default(cuid())
  fiscalYearId String
  name         String   // e.g. "January 2026"
  periodNumber Int
  startDate    DateTime
  endDate      DateTime
  status       String   @default("Open") // Open, Closed, Locked
  closedAt     DateTime?
  closedById   String?

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id])
  journals  Journal[]
}

// ============================
// Journal Entries (the heart of the GL)
// ============================

model Journal {
  id              String   @id @default(cuid())
  organizationId  String
  journalNumber   String   @unique
  journalDate     DateTime
  postingDate     DateTime?
  fiscalPeriodId  String?
  source          String?  // Manual, AP, AR, Payroll, etc.
  reference       String?
  description     String?
  currency        String   @default("USD")
  exchangeRate    Int    @default(100) // stored in basis points (100 = 1.0x)
  status          String   @default("Draft") // Draft, Submitted, Under Review, Approved, Rejected, Posted, Reversed
  reversalOfId    String?
  totalDebit      Int    @default(0)
  totalCredit     Int    @default(0)
  createdById     String
  submittedById   String?
  approvedById    String?
  postedById      String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  postedAt        DateTime?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  fiscalPeriod FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id])
  lines        JournalLine[]
  approvals    JournalApproval[]
  attachments  JournalAttachment[]
  reversalOf   Journal?       @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy   Journal[]      @relation("JournalReversal")
  createdBy    User            @relation("JournalCreatedBy", fields: [createdById], references: [id])
  submittedBy  User?           @relation("JournalSubmittedBy", fields: [submittedById], references: [id])
  approvedBy   User?           @relation("JournalApprovedBy", fields: [approvedById], references: [id])
  postedBy     User?           @relation("JournalPostedBy", fields: [postedById], references: [id])
}

model JournalLine {
  id            String   @id @default(cuid())
  journalId     String
  lineNumber    Int
  accountId     String
  description   String?
  debit         Int    @default(0)
  credit        Int    @default(0)
  taxCodeId     String?
  departmentId  String?
  locationId    String?
  projectId     String?
  customerId    String?
  vendorId      String?
  dueDate       DateTime?

  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id])
  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
}

model JournalApproval {
  id         String   @id @default(cuid())
  journalId  String
  action     String   // Submitted, Approved, Rejected, Posted, Reversed
  byUserId   String
  comment    String?
  at         DateTime @default(now())

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  byUser  User    @relation("JournalApprovals", fields: [byUserId], references: [id])
}

model JournalAttachment {
  id         String   @id @default(cuid())
  journalId  String
  fileName   String
  fileSize   Int
  mimeType   String
  url        String
  uploadedAt DateTime @default(now())

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
}

// ============================
// Vendors / Customers (AP / AR)
// ============================

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  vendorNumber   String
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  taxId          String?
  paymentTerms   String?  // e.g. "Net 30"
  currency       String   @default("USD")
  active         Boolean  @default(true)
  balance        Int    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  bills        Bill[]
  journalLines JournalLine[]
  purchaseOrders PurchaseOrder[]
}

model Bill {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String
  billNumber     String
  billDate       DateTime
  dueDate        DateTime
  amount         Int
  amountPaid     Int    @default(0)
  status         String   @default("Open") // Open, Partially Paid, Paid, Overdue
  description    String?
  createdAt      DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  customerNumber String
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  taxId          String?
  paymentTerms   String?
  currency       String   @default("USD")
  active         Boolean  @default(true)
  balance        Int    @default(0)
  creditLimit    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  invoices     Invoice[]
  journalLines JournalLine[]
  salesOrders  SalesOrder[]
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  invoiceNumber  String
  invoiceDate    DateTime
  dueDate        DateTime
  amount         Int
  amountPaid     Int    @default(0)
  status         String   @default("Open") // Open, Partially Paid, Paid, Overdue
  description    String?
  createdAt      DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}

// ============================
// Banking
// ============================

model BankAccount {
  id             String   @id @default(cuid())
  organizationId String
  accountName    String
  bankName       String?
  accountNumber  String
  accountType    String   @default("Checking") // Checking, Savings, Cash
  currency       String   @default("USD")
  balance        Int    @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  transactions BankTransaction[]
  reconciliations Reconciliation[]
}

model BankTransaction {
  id             String   @id @default(cuid())
  bankAccountId  String
  date           DateTime
  amount         Int
  type           String   // Credit (in), Debit (out)
  description    String?
  reference      String?
  reconciled     Boolean  @default(false)
  reconciledAt   DateTime?
  journalId      String?
  createdAt      DateTime @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
}

// ============================
// Tax
// ============================

model TaxCode {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  rate           Int    // e.g. 1400 for 14% (basis points × 100)
  jurisdiction   String?
  taxType        String   @default("VAT") // VAT, Sales Tax, GST
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ============================
// Dimensions
// ============================

model Department {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Location {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  active         Boolean  @default(true)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ============================
// Audit Log
// ============================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  action         String   // CREATE_JOURNAL, SUBMIT, APPROVE, POST, REVERSE, etc.
  entityType     String   // Journal, Account, User, etc.
  entityId       String?
  description    String
  metadata       String?  // JSON
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
}

// ============================
// Inventory Management (P4.1)
// ============================

model Product {
  id             String   @id @default(cuid())
  organizationId String
  sku            String
  name           String
  description    String?
  category       String?
  unit           String   @default("each") // each, kg, liter, hour, etc.
  costPrice      Int      @default(0) // in cents
  salePrice      Int      @default(0) // in cents
  stockQuantity  Int      @default(0)
  reorderPoint   Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  inventoryMoves InventoryMove[]
  poLines        PurchaseOrderLine[]
  soLines        SalesOrderLine[]

  @@unique([organizationId, sku])
}

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  location       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id])
  inventoryMoves InventoryMove[]

  @@unique([organizationId, code])
}

model InventoryMove {
  id           String   @id @default(cuid())
  organizationId String
  productId    String
  warehouseId  String?
  quantity     Int // positive = in, negative = out
  moveType     String // PURCHASE, SALE, ADJUSTMENT, TRANSFER, RETURN
  reference     String? // PO number, SO number, etc.
  notes         String?
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id])
}

// ============================
// Purchase Orders (P4.2)
// ============================

model PurchaseOrder {
  id             String   @id @default(cuid())
  organizationId String
  poNumber       String   @unique
  orderDate      DateTime
  expectedDate   DateTime?
  vendorId       String
  status         String   @default("Draft") // Draft, Submitted, Received, Cancelled
  totalAmount    Int      @default(0) // in cents
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  vendor       Vendor           @relation(fields: [vendorId], references: [id])
  lines        PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String?
  description     String
  quantity        Int
  unitPrice       Int // in cents
  totalPrice      Int // in cents
  receivedQty     Int @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id])
}

// ============================
// Sales Orders (P4.3)
// ============================

model SalesOrder {
  id             String   @id @default(cuid())
  organizationId String
  soNumber       String   @unique
  orderDate      DateTime
  expectedDate   DateTime?
  customerId     String
  status         String   @default("Draft") // Draft, Confirmed, Shipped, Delivered, Cancelled
  totalAmount    Int      @default(0) // in cents
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     Customer        @relation(fields: [customerId], references: [id])
  lines        SalesOrderLine[]
}

model SalesOrderLine {
  id           String @id @default(cuid())
  salesOrderId String
  productId    String?
  description  String
  quantity     Int
  unitPrice    Int // in cents
  totalPrice   Int // in cents
  shippedQty   Int @default(0)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id])
}

// ============================
// Bank Reconciliation (P4.4)
// ============================

model Reconciliation {
  id             String   @id @default(cuid())
  organizationId String
  bankAccountId  String
  statementDate  DateTime
  startingBalance Int    // in cents
  endingBalance   Int    // in cents
  status          String @default("Open") // Open, Reconciled
  createdAt       DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  bankAccount  BankAccount    @relation(fields: [bankAccountId], references: [id])
}

// ============================
// Recurring Journals (P4.5)
// ============================

model RecurringJournal {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  frequency      String   // DAILY, WEEKLY, MONTHLY, QUARTERLY, YEARLY
  nextRunDate    DateTime
  lastRunDate    DateTime?
  template       String   // JSON: { lines: [{ accountId, debit, credit, description }] }
  status         String   @default("Active") // Active, Paused, Stopped
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ============================
// Budgets (P4.6)
// ============================

model Budget {
  id             String   @id @default(cuid())
  organizationId String
  fiscalYearId   String?
  accountId      String
  period         String   // e.g. "2026-01" for January 2026, "2026" for full year
  budgetAmount   Int      // in cents
  actualAmount   Int      @default(0) // in cents, updated from posted journals
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  fiscalYear    FiscalYear?  @relation(fields: [fiscalYearId], references: [id])
  account       Account      @relation(fields: [accountId], references: [id])

  @@unique([organizationId, accountId, period])
}
